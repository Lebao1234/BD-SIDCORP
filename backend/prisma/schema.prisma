generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int                   @id @default(autoincrement())
  email             String                @unique
  name              String?
  password          String
  role              Role                  @default(user)
  approved          Boolean               @default(false)
  avatar_url        String?
  uploadedDocuments CustomerDocument[]    @relation("DocumentUploader")
  mentionsMade      CustomerNoteMention[] @relation("MentionedBy")
  mentionsReceived  CustomerNoteMention[] @relation("MentionedUser")
  customers         Customer[]            @relation("CustomerOwner")
  exchanges         Exchange[]            @relation("ExchangeWriter")
  tasks             Task[]                @relation("TaskOwner")
  assets            Asset[]

  @@map("users")
}

model Customer {
  id           Int                   @id @default(autoincrement())
  name         String?
  field        String?
  from_source  String?
  price        Decimal?              @db.Decimal(15, 0)
  status       String?
  classified   Classified?
  email        String?               @unique
  phone_number String?               @unique
  address      String?
  link_url     String?
  appointment  DateTime?
  note         String?
  reject_reason String?
  current_step  String?
  owner_id     Int?
  created_at   DateTime              @default(now())
  updated_at   DateTime              @updatedAt
  company_id   Int?
  documents    CustomerDocument[]
  mentions     CustomerNoteMention[]
  company      Company?              @relation(fields: [company_id], references: [id])
  owner        User?                 @relation("CustomerOwner", fields: [owner_id], references: [id])
  exchanges    Exchange[]
  tasks        Task[]
  assetUsages  AssetUsage[]

  @@index([owner_id, created_at])
  @@index([status])
  @@map("customers")
}

model CustomerDocument {
  id          Int      @id @default(autoincrement())
  customer_id Int
  file_name   String?
  file_url    String?
  uploaded_by Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
  uploader    User     @relation("DocumentUploader", fields: [uploaded_by], references: [id])

  @@map("customer_documents")
}

model Exchange {
  id          Int      @id @default(autoincrement())
  customer_id Int
  writer_id   Int
  content     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
  writer      User     @relation("ExchangeWriter", fields: [writer_id], references: [id])

  @@map("exchanges")
}

model CustomerNoteMention {
  id                Int      @id @default(autoincrement())
  customer_id       Int
  mentioned_user_id Int
  mentioned_by      Int
  created_at        DateTime @default(now())
  customer          Customer @relation(fields: [customer_id], references: [id])
  mentionedByUser   User     @relation("MentionedBy", fields: [mentioned_by], references: [id])
  mentionedUser     User     @relation("MentionedUser", fields: [mentioned_user_id], references: [id])

  @@map("customer_note_mentions")
}

model Company {
  id              Int           @id @default(autoincrement())
  name            String
  tax_code        String?       @unique
  email           String?       @unique
  phone           String?
  website         String?
  facebook        String?
  linkedin        String?
  zalo            String?
  address         String?
  location        String?
  field           String?
  status          CompanyStatus @default(potential)
  note            String?
  bank_name       String?
  bank_account_no String?
  bank_branch     String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  customers       Customer[]

  @@map("companies")
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  type        TaskType     @default(TASK)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)

  // start_at/end_at cho việc có khung giờ (họp, buổi làm việc).
  // due_at cho việc chỉ có hạn chót, không gắn giờ cụ thể.
  start_at    DateTime?
  end_at      DateTime?
  due_at      DateTime?
  all_day     Boolean      @default(false)

  location    String?

  // Nhắc trước bao nhiêu phút; reminded_at là chốt chặn để không nhắc lặp
  remind_before_minutes Int?
  reminded_at DateTime?

  customer_id  Int?
  owner_id     Int
  completed_at DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  customer Customer? @relation(fields: [customer_id], references: [id])
  owner    User      @relation("TaskOwner", fields: [owner_id], references: [id])

  @@index([owner_id, status, start_at])
  @@index([owner_id, due_at])
  @@index([customer_id])
  @@map("tasks")
}

enum TaskType {
  TASK
  MEETING
  CALL
  FOLLOW_UP
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum Role {
  admin
  user
}

enum Classified {
  VIP
  Normal
  Lead
}

enum CompanyStatus {
  active
  inactive
  potential
}

model Asset {
  id          Int          @id @default(autoincrement())
  type        AssetType    @default(DOCUMENT)
  title       String
  description String?
  category    String?
  status      AssetStatus  @default(READY)
  tags        String[]     @default([])
  file_url    String       // Link Google Drive
  file_name   String?
  format      String?      // docs, sheets, slides, folder, pdf, other
  meta        Json?
  owner_id    Int
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  owner       User         @relation(fields: [owner_id], references: [id])
  usages      AssetUsage[]

  @@index([type, category])
  @@index([owner_id])
  @@map("assets")
}

model AssetUsage {
  id          Int       @id @default(autoincrement())
  asset_id    Int
  customer_id Int?
  used_at     DateTime  @default(now())
  note        String?

  asset       Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@map("asset_usages")
}

enum AssetType {
  DOCUMENT
  SOCIAL_POST
  EMAIL_TEMPLATE
}

enum AssetStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}
