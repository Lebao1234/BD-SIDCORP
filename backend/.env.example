# ─── SERVER ───────────────────────────────────────────────────────────────────
# Cổng chạy của Backend (Mặc định: 5000)
PORT=5000

# Danh sách origin được phép gọi API, phân tách bởi dấu phẩy
# VD: https://portal.sidcorp.vn,https://sidcorp.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── POSTGRESQL (Supabase) ────────────────────────────────────────────────────
# Transaction Pooler (port 6543) - Dùng cho ứng dụng chạy runtime
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Session Pooler (port 5432) - Dùng cho Prisma db push / migrate
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ─── MONGODB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ─── SUPABASE STORAGE ─────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# ─── BẢO MẬT ──────────────────────────────────────────────────────────────────
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# ─── REDIS (TUỲ CHỌN) ─────────────────────────────────────────────────────────
# Chỉ cần khi chạy NHIỀU instance backend song song. Bỏ trống thì hệ thống chạy
# bình thường ở chế độ một instance.
#
# Có Redis thì hai thứ sau hoạt động đúng khi scale ngang:
#   - Socket.io dùng Redis adapter: tin nhắn phát ở instance này tới được người
#     đang kết nối vào instance kia.
#   - Vòng nhắc lịch giành khoá trước mỗi lượt, nên một cuộc họp chỉ được nhắc
#     một lần thay vì nhắc theo số instance đang chạy.
#
# REDIS_URL=redis://default:password@host:6379
